# Optional overrides
GEMINI_MODEL=gemini-3.6-flash
PORT=8080
AI_TIMEOUT_MS=75000
AI_THINKING_LEVEL=LOW
RATE_LIMIT_PER_MINUTE=20
PLAN_CACHE_TTL_MS=600000
TRUST_PROXY=1
