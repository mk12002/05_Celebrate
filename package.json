{
  "name": "celebrate-ai-event-planner",
  "version": "1.0.0",
  "description": "Gemini-powered planning assistant for weddings, birthdays and community events: budget breakdowns, timelines, vendor checklists, themes and conversational refinement.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --omit=dev --audit-level=moderate",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run audit",
    "typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [
    "gemini",
    "generative-ai",
    "event-planner",
    "wedding",
    "birthday",
    "promptwars"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3"
  }
}
